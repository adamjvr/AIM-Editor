{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aim-editor.org/schema/midi-capture.schema.json",
  "title": "AIM Editor MIDI Capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "exported_at_utc_ms",
    "events"
  ],
  "properties": {
    "format": {
      "const": "aim-editor.midi-capture"
    },
    "schema_version": {
      "const": 1
    },
    "exported_at_utc_ms": {
      "type": "integer"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "nrpn_transactions": {
      "type": "array",
      "description": "Optional stateful candidate interpretation of complete CC99/CC98/CC6/CC38 NRPN transactions. Raw events remain authoritative.",
      "items": {
        "$ref": "#/$defs/nrpn_transaction"
      }
    },
    "verification_context": {
      "type": "object",
      "description": "Optional human-entered experiment tag. It does not change the raw capture and is used by offline verification tooling.",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "parameter_known",
        "user_confirmed_control_isolation",
        "note"
      ],
      "properties": {
        "parameter_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameter_known": {
          "type": "boolean"
        },
        "user_confirmed_control_isolation": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "experiment_started_utc_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "experiment_completed_utc_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "capture_frozen": {
          "type": "boolean"
        },
        "observed_expected_nrpn_transactions": {
          "type": "integer",
          "minimum": 0
        },
        "observed_distinct_semantic_values": {
          "type": "integer",
          "minimum": 0
        },
        "observed_competing_nrpn_numbers": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "utc_ms",
        "device_identifier",
        "kind",
        "size",
        "hex",
        "bytes"
      ],
      "properties": {
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "utc_ms": {
          "type": "integer"
        },
        "device_identifier": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "hex": {
          "type": "string"
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "sysex_payload_size": {
          "type": "integer",
          "minimum": 0
        },
        "sysex_payload_hex": {
          "type": "string"
        },
        "ion_candidate_patch": {
          "type": "object",
          "description": "Optional candidate interpretation of a structurally valid Ion single-patch dump. Raw capture bytes remain authoritative.",
          "additionalProperties": true
        },
        "ion_candidate_program": {
          "type": "object",
          "description": "Optional human-readable AIM program decoded through candidate Ion field mappings. Raw MIDI/SysEx bytes remain authoritative."
        }
      }
    },
    "nrpn_transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "utc_ms",
        "device_identifier",
        "midi_channel",
        "nrpn",
        "value14",
        "mapping_status",
        "value_encoding",
        "parameter_id",
        "parameter_name",
        "semantic_value"
      ],
      "properties": {
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "utc_ms": {
          "type": "integer"
        },
        "device_identifier": {
          "type": "string"
        },
        "midi_channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "nrpn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "value14": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "mapping_status": {
          "enum": [
            "unmapped",
            "candidate",
            "verified"
          ]
        },
        "value_encoding": {
          "type": "string"
        },
        "parameter_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameter_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "semantic_value": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
