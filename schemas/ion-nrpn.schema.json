{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aim-editor.org/schemas/ion-nrpn.schema.json",
  "title": "AIM Editor candidate Ion NRPN specification",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "device",
    "research_state",
    "transport",
    "parameters"
  ],
  "properties": {
    "format": {
      "const": "aim-editor.ion-nrpn-spec"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "device": {
      "type": "object"
    },
    "research_state": {
      "type": "object"
    },
    "transport": {
      "type": "object"
    },
    "known_conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "id",
          "name",
          "min",
          "max",
          "value_encoding",
          "status",
          "hardware_verified"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16383
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "value_encoding": {
            "enum": [
              "unsigned_14",
              "signed_14_wrap"
            ]
          },
          "status": {
            "enum": [
              "candidate",
              "verified"
            ]
          },
          "hardware_verified": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
